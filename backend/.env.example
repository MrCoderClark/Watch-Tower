DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@HOST/DB?sslmode=require"
SECRET_KEY="generate-with-openssl-rand-hex-32"
ENVIRONMENT="development"

INTERNAL_DSN=http://localhost:8000/wt_pub_YOURKEY

# Uptime alerts. Grab from a channel's incoming-webhook config. Unset = no alerts fired.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
# RUN_UPTIME_WORKER=true
